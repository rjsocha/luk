#!/bin/bash
# Replays the masked prompts of a bare luk send --secret for the demo: the
# secret typed twice, one star per key, then the URL luk prints.
set -eufo pipefail
IFS=$'\t\n'
stars() {
  local i
  for ((i = 0; i < 11; i++)); do
    printf "*" >&2
    sleep 0.09
  done
  printf "\n" >&2
}
printf "secret: " >&2
sleep 0.6
stars
printf "retype: " >&2
sleep 0.4
stars
cat "$(dirname "$0")/render/secret.txt"
