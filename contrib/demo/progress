#!/bin/bash
# Replays the progress line of luk send --progress for the demo: 114.4 MiB
# sent in about four seconds, then the URL luk prints.
set -eufo pipefail
IFS=$'\t\n'
total=114.4
for pct in 0 6 14 23 31 40 49 57 66 74 83 91 100; do
  sent=$(awk -v t="$total" -v p="$pct" 'BEGIN { printf "%.1f", t * p / 100 }')
  printf "\r%s MiB / %s MiB  %3d%%  28.6 MiB/s" "$sent" "$total" "$pct" >&2
  sleep 0.3
done
printf "\n" >&2
cat "$(dirname "$0")/render/send.txt"
