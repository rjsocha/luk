#!/bin/sh
set -e

if [ "$1" = configure ]; then
  systemd-sysusers luk.conf
  systemd-tmpfiles --create luk.conf
  for d in /etc/site/lukd /etc/site/lukd/config.d /etc/site/lukd/ssh.d /etc/site/lukd/ssh.d/ca /etc/site/lukd/ssh.d/ca/host /etc/site/lukd/ssh.d/ca/user /etc/site/lukd/gpg.d; do
    [ -d "$d" ] || install -d -o root -g luk -m 0750 "$d"
  done
  [ -d /etc/site/lukd/run.d ] || install -d -o root -g root -m 0755 /etc/site/lukd/run.d
  # The identity key authenticates lukd to its clients; an existing one is
  # kept (a package upgrade must not change the pin).
  lukd key generate --if-missing
  [ ! -e /etc/site/lukd/identity.key ] || { chown root:luk /etc/site/lukd/identity.key; chmod 0640 /etc/site/lukd/identity.key; }
  systemctl daemon-reload || true
  if [ -n "$2" ]; then
    systemctl try-restart lukd-receive.service lukd-process.service || true
    # A running lukd wants its run socket; an upgrade does not restart
    # lukd.service itself, so start what it would pull in.
    if systemctl is-active --quiet lukd.service; then
      systemctl start lukd-run.socket || true
    fi
  fi
fi
