[Unit]
Description=luk server (receive and process roles)
# Groups lukd-receive.service and lukd-process.service: start, stop,
# restart and reload of lukd act on both roles; each role can still be
# restarted or reloaded alone. Also pulls in the socket of lukd run,
# which every run and relay step needs, and the removal of leftover
# workspaces of lukd run (at start, then every 15 minutes).
Wants=lukd-receive.service lukd-process.service lukd-run.socket lukd-run-prune.service lukd-run-prune.timer

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true
# systemctl reload lukd: the configuration is checked first, so an
# invalid one or a change of root, listen, limits.conn/header or
# auth.nonces (they need a restart) fails the reload visibly; the reload
# then reaches both roles (ReloadPropagatedFrom= in their units), each
# checks again and sends itself SIGHUP.
ExecReload=/usr/bin/lukd check
# A oneshot unit has no start timeout by default, and ExecReload= runs
# under it: bound the check so a stuck reload cannot hang.
TimeoutSec=5min

[Install]
WantedBy=multi-user.target
