[Unit]
Description=luk run socket (steps and jobs of lukd run in units of their own)

[Socket]
ListenStream=/run/luk/run.sock
SocketUser=root
SocketGroup=luk
SocketMode=0660
# /run/luk itself comes from tmpfiles.d (deploy/luk.tmpfiles.conf) as
# root:luk 0750; a directory created here would be root:root and closed
# to luk.
DirectoryMode=0750
Accept=yes
# A backstop: the limit of running units is limits.units.max of run.yaml.
MaxConnections=1024

[Install]
WantedBy=sockets.target
