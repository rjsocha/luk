[Unit]
Description=luk server, process role (pipelines, status, storage maintenance)
After=network-online.target
Wants=network-online.target
# Like the receive role, which takes the acceptance order of the uploads
# from the wall clock, it starts after the clock is synchronized.
After=time-sync.target
# Started, stopped, restarted and reloaded with lukd.service, which also
# runs lukd-receive.service.
PartOf=lukd.service
ReloadPropagatedFrom=lukd.service

[Service]
User=luk
Group=luk
ExecStart=/usr/bin/lukd process
# systemctl reload lukd-process: the configuration is checked first, so an
# invalid one or a change of root, listen, limits.conn/header or
# auth.nonces (they need a restart) fails the reload visibly; lukd then
# reloads it on SIGHUP. The kill runs outside the sandbox ("+"): with
# PrivatePIDs= the unit has its own PID namespace, where $MAINPID of the
# host does not exist.
ExecReload=/usr/bin/lukd check --no-identity
ExecReload=+/bin/kill -HUP $MAINPID
Restart=on-failure
# SIGTERM to lukd only: it closes the connections of the running steps,
# so lukd run stops their units, and leaves their uploads queued; systemd
# kills what is left after the stop timeout.
KillMode=mixed
# No listener and no capability.
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
# /var/lib/luk is shared with lukd-receive.service and created by
# tmpfiles.d (deploy/luk.tmpfiles.conf), not by StateDirectory; the
# data of luk is <root>/data, the workspaces of lukd run <root>/root.
ReadWritePaths=/var/lib/luk
# Volatile secrets (endpoint secret) on the tmpfs; "-": absent is fine.
ReadWritePaths=-/run/luk/volatile
ProtectHome=read-only
PrivateTmp=yes
# The keys of the receive role stay out of reach of this role: the TLS and
# ACME keys and the nonce cache are hidden ("-": absent is fine). The run
# programs do not run here but in units of lukd run. A root other than
# /var/lib/luk or tls files elsewhere need their paths in a drop-in.
InaccessiblePaths=-/var/lib/luk/data/tls -/var/lib/luk/data/acme -/run/luk/nonces -/etc/site/lukd/identity.key
# No ptrace or process_vm_readv, and an own PID namespace: the memory of
# lukd receive cannot be read from here.
SystemCallFilter=~@debug
PrivatePIDs=yes
# Drop-ins (systemctl edit lukd-process); examples in
# /usr/share/doc/lukd/examples/lukd-process.service.d:
#
#   # storage.conf: a storage base (also in lukd-receive) outside
#   # /var/lib/luk
#   [Service]
#   ReadWritePaths=/storage
#
#   # limits.conf: bounds of lukd process itself
#
#   # lukd run: nothing to grant. ProtectSystem=strict keeps
#   # /run/luk/run.sock reachable (a connect is not a write to the file
#   # system); the socket mode (root:luk 0660) is the gate.

[Install]
WantedBy=lukd.service
