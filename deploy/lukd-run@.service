[Unit]
Description=luk run connection (one step request)
# Started per connection by lukd-run.socket.
CollectMode=inactive-or-failed

[Service]
# Root: reads /etc/site/lukd/run.yaml, run.d/ and the pipelines of
# config.yaml and config.d/, takes a unit slot (limits.units.max), has a
# workspace made by a helper unit and starts the step with systemd-run,
# which needs no polkit as root. The step runs in its own transient unit,
# outside this sandbox, and leaves a workspace removed by a second helper
# unit; leftovers are removed by lukd-run-prune.service.
ExecStart=/usr/bin/lukd run
StandardInput=socket
StandardOutput=socket
StandardError=journal
# Bounds of one connection. They do not reach the job: systemd-run asks
# the service manager for a transient unit of its own in system.slice,
# outside this unit's cgroup. lukd run itself ends the request within 5s
# and a job with its output within the job timeout plus 2 minutes;
# RuntimeMaxSec is only a backstop above a wait for a state lock (a peer
# closes within its pipeline timeout, under 7 days) plus a job timeout
# (under 7 days as well).
MemoryMax=128M
TasksMax=64
RuntimeMaxSec=15d
# Lock files shared by all instances: the unit slots (slot/<n>.lock), the
# workspaces in use (.ws/<unit>.lock) and the jobs with state: locked
# (<job>/<pipeline>.lock). Kept when an instance stops, emptied by a reboot.
RuntimeDirectory=lukd-run
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
# No capability: systemd-run needs none, and the workspaces are made and
# removed by helper units of their own.
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
# The identity key of lukd receive and the passwords of the encrypt steps
# of lukd process stay out of reach of the run programs.
InaccessiblePaths=-/etc/site/lukd/identity.key -/etc/site/lukd/password.d
PrivateTmp=yes
PrivateDevices=yes
# Processes of other users (luk, the jobs) are hidden in /proc.
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077
